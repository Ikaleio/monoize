{"id": "openai-messages-text-document", "source": "messages", "request": {"model": "audit", "max_tokens": 1, "messages": [{"role": "user", "content": [{"type": "document", "source": {"type": "text", "media_type": "text/plain", "data": "private document text"}, "title": "memo"}]}]}, "strip": true}
