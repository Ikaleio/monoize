{"id": "openai-assistant-image", "source": "responses", "request": {"model": "audit", "input": [{"role": "assistant", "content": [{"type": "input_image", "image_url": "data:image/png;base64,YQ=="}]}]}, "strip": false}
{"id": "openai-assistant-file", "source": "responses", "request": {"model": "audit", "input": [{"role": "assistant", "content": [{"type": "input_file", "filename": "memo.txt", "file_data": "data:text/plain;base64,YQ=="}]}]}, "strip": false}
{"id": "openai-file-filename-url", "source": "responses", "request": {"model": "audit", "input": [{"role": "user", "content": [{"type": "input_file", "file_url": "https://example.com/report.pdf", "filename": "renamed.pdf", "detail": "high"}]}]}, "strip": false}
{"id": "openai-file-filename-id", "source": "responses", "request": {"model": "audit", "input": [{"role": "user", "content": [{"type": "input_file", "file_id": "file_123", "filename": "renamed.pdf", "detail": "high"}]}]}, "strip": false}
{"id": "openai-file-data-pdf", "source": "responses", "request": {"model": "audit", "input": [{"role": "user", "content": [{"type": "input_file", "filename": "report.pdf", "file_data": "data:application/pdf;base64,JVBERi0="}]}]}, "strip": true}
{"id": "openai-file-raw-pdf", "source": "responses", "request": {"model": "audit", "input": [{"role": "user", "content": [{"type": "input_file", "filename": "report.pdf", "file_data": "JVBERi0="}]}]}, "strip": true}
{"id": "openai-image-data-url", "source": "responses", "request": {"model": "audit", "input": [{"role": "user", "content": [{"type": "input_image", "image_url": "data:image/png;base64,YQ==", "detail": "high"}]}]}, "strip": true}
{"id": "openai-responses-stable-audio", "source": "responses", "request": {"model": "audit", "input": [{"role": "user", "content": [{"type": "input_audio", "input_audio": {"data": "YQ==", "format": "wav"}}]}]}, "strip": false}
{"id": "openai-tool-multimedia", "source": "responses", "request": {"model": "audit", "input": [{"type": "function_call_output", "call_id": "call_1", "output": [{"type": "input_text", "text": "read"}, {"type": "input_image", "image_url": "https://example.com/a.png"}, {"type": "input_file", "filename": "memo.txt", "file_data": "data:text/plain;base64,YQ=="}]}]}, "strip": true}
{"id": "openai-docx-data", "source": "responses", "request": {"model": "audit", "input": [{"role": "user", "content": [{"type": "input_file", "filename": "memo.docx", "file_data": "data:application/vnd.openxmlformats-officedocument.wordprocessingml.document;base64,YQ=="}]}]}, "strip": true}
